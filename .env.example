# Free local upstream. For OpenAI, use https://api.openai.com and a real key.
UPSTREAM_BASE_URL=http://ollama:11434
UPSTREAM_MODEL=qwen2.5:0.5b
OPENAI_API_KEY=ollama

# Granite Guardian served by vLLM on the host.
GUARDIAN_BASE_URL=http://host.docker.internal:8001/v1
GUARDIAN_MODEL=ibm-granite/granite-guardian-3.1-2b
GUARDIAN_API_KEY=unused
GUARDIAN_RISK_THRESHOLD=0.5
GUARDIAN_TIMEOUT_SECONDS=30

PROXY_BASE_URL=https://localhost:8443/v1
CA_CERT=certs/ca.crt
